# Copiar a .env (ignorado por git) y descomentar lo que se quiera cambiar.
# La app lo lee al arrancar desde el directorio de trabajo (./gradlew bootRun).
#
# Formato properties, NO shell:
#   - sin "export" adelante;
#   - sin comillas: LINK_DURATION="PT40M" incluye las comillas en el valor.
# Una variable de entorno real (LINK_DURATION=PT5M ./gradlew bootRun) le gana
# al valor de este archivo. Tabla completa en el README, «Configuración de
# despliegue».

# Duración ISO-8601 de las nuevas asignaciones. Ojo: un número sin unidad
# (LINK_DURATION=40) se interpreta en milisegundos; usar PT40M o 40m.
#LINK_DURATION=PT60M

#PUBLIC_BASE_URL=http://localhost:8080
#OWN_ORIGINS=
#RESERVED_ROUTES=api,error
#MAX_DESTINATION_LENGTH=8192
#SERVER_PORT=8080

#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=acortador
#DB_USER=acortador
#DB_PASSWORD=acortador
