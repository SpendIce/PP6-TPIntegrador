# Copiar a .env (ignorado por git) y descomentar lo que se quiera cambiar.
# La app lo lee al arrancar desde el directorio de trabajo (./gradlew bootRun).
#
# Formato properties, NO shell:
#   - sin "export" adelante;
#   - sin comillas: LINK_DURATION="PT40M" incluye las comillas en el valor.
# Una variable de entorno real (LINK_DURATION=PT5M ./gradlew bootRun) le gana
# al valor de este archivo. Los defaults viven solo en
# src/main/resources/application.yml: una clave descomentada pero vacía no
# vuelve al default (LINK_DURATION, ALIAS_ALPHABET, ALIAS_ROUTE_PATTERN o
# NAMESPACE_RESERVED_NAMES vacías cortan el arranque). Tabla completa en
# el README, «Configuración de despliegue».

# Duración ISO-8601 de las nuevas asignaciones, mínimo un minuto. Un número
# sin unidad (LINK_DURATION=40) son milisegundos y corta el arranque: usar
# PT40M o 40m.
#LINK_DURATION=PT60M

#PUBLIC_BASE_URL=http://localhost:8080
#OWN_ORIGINS=
#RESERVED_ROUTES=api,error,login,oauth2
#MAX_DESTINATION_LENGTH=8192
#SERVER_PORT=8080

# Credenciales OIDC de la aplicación en Google Cloud (sin default: el
# arranque las exige y corta nombrando la que falta). El alta y la URI de
# redirección (${PUBLIC_BASE_URL}/login/oauth2/code/google) se describen
# en docs/despliegue-funnel-google.md.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Inactividad máxima ISO-8601 de la sesión principal persistida.
#MAIN_SESSION_IDLE_TIMEOUT=P30D

# Inactividad máxima ISO-8601 de la sesión vinculada por QR; se graba al
# abrirla la consulta que consume el código aprobado (issue #22).
#LINKED_SESSION_IDLE_TIMEOUT=PT12H

# Vigencia ISO-8601 del código de vinculación de un solo uso; la web lo
# renueva antes de que venza. Mínimo PT5S: por debajo el código vence
# antes de que la web consulte su estado una vez.
#LINK_CODE_TTL=PT60S

# Nombres que ningún usuario puede elegir como namespace porque chocan
# con rutas del propio servicio. Lista separada por comas, sin espacios.
#NAMESPACE_RESERVED_NAMES=api,login,logout,vincular,oauth2,error

# Tiempo que el namespace anterior queda reservado después de un cambio.
# Cada cambio fija su propio fin; luego modificar el valor no lo altera.
#NAMESPACE_GRACE_PERIOD=PT1H

#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=acortador
#DB_USER=acortador
#DB_PASSWORD=acortador
